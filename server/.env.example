# ==========================================================================
# PULSERED - Production Environment Configuration Template
# Copy to .env for production deployment
# ==========================================================================

# Server Settings
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://localhost:5500

# Security Secrets (Must be changed in production!)
JWT_SECRET=pulsered_production_super_secret_jwt_key_998877665544332211
JWT_REFRESH_SECRET=pulsered_production_refresh_secret_key_112233445566778899

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:8080/callback

# Database Connection (Optional: standard PostgreSQL URI)
# DATABASE_URL=postgres://user:password@localhost:5432/pulsered_db
# REDIS_URL=redis://localhost:6379
